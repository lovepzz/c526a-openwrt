# ============================================================================
# OpenWrt 25.12 — HiWiFi C526A (极路由X)
# 正常路由模式 · 启用 Wi-Fi · 官方 ath10k（非 CT）
# ★ 通过 CONFIG_TARGET_DEVICE_PACKAGES 的减号语法强制移除 CT 默认包
# ============================================================================

# ---------- Target ----------
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_hiwifi_c526a=y

# ---------- ★ 核心：覆盖设备默认包，移除 CT 并加入官方 ath10k ----------
# ipq40xx 的 DEFAULT_PACKAGES 硬编码了 kmod-ath10k-ct / ath10k-firmware-qca4019-ct，
# 仅修改 CONFIG_PACKAGE_* 会被 defconfig 覆盖。此行的减号会从默认列表中剔除 CT 包，
# 然后加入官方驱动与固件。这是 Gluon / Gargoyle 在 ipq40xx 上切换 ath10k 的标准方式。
CONFIG_TARGET_DEVICE_PACKAGES_ipq40xx_generic_DEVICE_hiwifi_c526a="-kmod-ath10k-ct -ath10k-firmware-qca4019-ct kmod-ath10k ath10k-firmware-qca4019 ath10k-board-qca4019"

# ---------- 包管理器（25.12 实际仍会使用 apk，见上方说明）----------
CONFIG_USE_APK=n
CONFIG_PACKAGE_opkg=y

# ---------- 官方 ath10k（显式选中作为后备）----------
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_ath10k-firmware-qca4019=y
CONFIG_PACKAGE_ath10k-board-qca4019=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ---------- USB ----------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y

# ---------- LuCI + 中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------- 网络基础 ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ipv6helper=y

# ---------- 常用工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ca-bundle=y

# ---------- 调试与构建 ----------
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_INFO_BTF=n
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=n
CONFIG_DEBUG=n

# ---------- 版本标识 ----------
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt-C526A"
CONFIG_VERSION_NUMBER="25.12-ath10k-wifi"
CONFIG_VERSION_MANUFACTURER="HiWiFi"
CONFIG_VERSION_PRODUCT="C526A"
