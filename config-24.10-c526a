# ============================================================================
# OpenWrt 24.10 — HiWiFi C526A (极路由X)
# 主路由模式 + 三频无线 + 完整 LuCI 中文 + LAN 10.0.0.5
# ============================================================================

# ---------- Target ----------
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_hiwifi_c526a=y

# ---------- 内核 ----------
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_INFO_BTF=n
CONFIG_DEBUG=n

# ============================================================================
# 无线驱动与固件（C526A 三频核心）
# ============================================================================
# IPQ4019 内置 2.4G + 5G
CONFIG_PACKAGE_kmod-ath10k-ct=y
CONFIG_PACKAGE_ath10k-firmware-qca4019-ct=y
CONFIG_PACKAGE_ath10k-firmware-qca4019-ct-htt=y

# MT7615 外挂 5G（注意固件包名是 kmod-mt7615-firmware）
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y

# 无线管理工具与认证
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# ============================================================================
# LuCI 核心 + 完整中文
# ============================================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-firewall-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-commands-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-ddns-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-upnp-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-sqm-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-statistics-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-wol-zh_Hans=y

# ============================================================================
# 主路由核心：PPPoE + DHCP + DNS + IPv6
# ============================================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# dnsmasq-full 与 dnsmasq 互斥，显式禁用基础版
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ============================================================================
# 防火墙（firewall4 + nftables）
# firewall4 会自动拉取所需 kmod，无需手动指定
# ============================================================================
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# ============================================================================
# 常用 LuCI 应用
# ============================================================================
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-wol=y

# ============================================================================
# 常用命令行工具
# ============================================================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_ethtool=y

# ============================================================================
# NAND / UBI 维护工具
# ============================================================================
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uboot-envtools=y

# ============================================================================
# C526A 硬件支持：按键、LED
# ============================================================================
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-ledtrig-default-on=y
CONFIG_PACKAGE_kmod-ledtrig-heartbeat=y

# ============================================================================
# 版本标识
# ============================================================================
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt-C526A"
CONFIG_VERSION_NUMBER="24.10-luci-wifi-lan10"
CONFIG_VERSION_MANUFACTURER="HiWiFi"
CONFIG_VERSION_PRODUCT="C526A"

# ============================================================================
# 构建选项
# ============================================================================
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=n
